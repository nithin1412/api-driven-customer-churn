# Prefect credentials should normally be configured through the Prefect CLI/profile.
# Do not commit real API keys.

# Optional settings consumed by the FastAPI Prefect metadata endpoint.
# Leave blank if the local Prefect profile is already connected to Prefect Cloud.
PREFECT_API_URL=
PREFECT_API_KEY=

# Deployment metadata used by the API endpoint.
PREFECT_FLOW_NAME=customer-churn-pipeline
PREFECT_DEPLOYMENT_NAME=customer-churn-cloud
